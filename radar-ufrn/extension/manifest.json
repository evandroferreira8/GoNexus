{
  "manifest_version": 3,
  "name": "GO Nexus - Radar UFRN (experimental)",
  "version": "0.1.0",
  "description": "Monitora somente dados já carregados no mapa aberto pelo usuário e sinaliza IV 100% na área da UFRN.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://ntfy.sh/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pogocoordinates.com/map*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://pogocoordinates.com/map*"
      ],
      "js": [
        "map-content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://evandroferreira8.github.io/*"
      ],
      "js": [
        "nexus-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}